# ==============================================
#  CARBON GRILL
# ==============================================
JWT_SECRET=carbon_grill_cambiar_este_secreto_largo
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Puerto distinto a Repuestos (3778), CiberCafé (3788) y Clínica López (3789)
PORT=3790
API_PREFIX=api

CORS_ORIGINS=http://localhost:4203

# ==============================================
#  BASE DE DATOS
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=app_carbon_grill

# ==============================================
#  CORREOS (SMTP)
# ==============================================
SMTP_HOST=CAMBIAR
SMTP_PORT=465
SMTP_USER=CAMBIAR
SMTP_PASS=CAMBIAR
SMTP_FROM="Carbon Grill <noreply@carbongrill.local>"

FRONTEND_URL=http://localhost:4203

# SUNAT / OSE. En pruebas: BETA (SOAP e-beta, mismas credenciales que Repuestos AT).
# En producción: NUBEFACT con URL/token por sucursal.
OSE_MODO=BETA
OSE_PROVEEDOR=SUNAT_BETA
OSE_FALLA_CONTINGENCIA=false
NUBEFACT_URL=
NUBEFACT_TOKEN=
EMPRESA_RUC=20481099936
EMPRESA_RAZON_SOCIAL=CARBON GRILL SAC
EMPRESA_NOMBRE_COMERCIAL=CARBON GRILL
EMPRESA_UBIGEO=150101
EMPRESA_DIRECCION=LIMA
EMPRESA_DEPARTAMENTO=LIMA
EMPRESA_PROVINCIA=LIMA
EMPRESA_DISTRITO=LIMA

SUNAT_PROVIDER=beta
SUNAT_AMBIENTE=BETA
SUNAT_RUC_EMISOR=20481099936
SUNAT_USUARIO_SOL=20481099936MODDATOS
SUNAT_CLAVE_SOL=MODDATOS
SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_WSDL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService?wsdl
